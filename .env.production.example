# ==============================================================================
# TalimCRM — Production Environment Variables Configuration
# Nusxa oling va serverda '.env' yoki '.env.production' nomi bilan saqlang:
#   cp .env.production.example .env
# ==============================================================================

# --- Asosiy Domen Sozlamalari ---
# Asosiy domen. Har bir markaz sayti: <markaz>.DOMAIN (masalan ilmmarkazi.talimcrm.uz).
# DNS: @, www va * (wildcard) A yozuvlari server IP siga yo'naltirilgan bo'lishi kerak.
DOMAIN=talimcrm.uz
FRONTEND_URL=https://talimcrm.uz
NEXT_PUBLIC_API_URL=/api

# --- Ma'lumotlar Bazasi (PostgreSQL 16) ---
POSTGRES_USER=talimcrm_admin
POSTGRES_PASSWORD=O_zingizningMurakkabMaxfiyParolingizniKiriting_!987
POSTGRES_DB=talimcrm_prod

# --- Redis Keshlash & Seanslar ---
REDIS_PASSWORD=RedisKuchliMaxfiyParol_2026_!#

# --- Xavfsizlik & Autentifikatsiya (JWT) ---
# Kamida 64 ta belgidan iborat tasodifiy satr yarating: openssl rand -hex 32
JWT_SECRET=production-ultra-secure-random-jwt-secret-string-replace-this-now-123456789
JWT_EXPIRES_IN=7d

# --- Zaxira nusxalash (Avtomatik Backup) ---
BACKUP_KEEP_DAYS=14

# ==============================================================================
# Ixtiyoriy Tashqi Integratsiyalar
# (Har qanday kalit bo'sh qoldirilsa, o'sha funksiya avtomatik o'chirilgan holda ishlaydi)
# ==============================================================================

# --- Telegram Bot (Davomat, to'lovlar va dars xabarnomalari uchun) ---
# @BotFather orqali olingan token va @ belgisisiz bot foydalanuvchi nomi
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Webhook maxfiy kaliti (openssl rand -hex 24). scripts/production/set-telegram-webhook.sh ishlatadi.
TELEGRAM_WEBHOOK_SECRET=

# --- Click To'lov Tizimi (Markaz o'z o'quvchilaridan qabul qilishi uchun) ---
# my.click.uz merchant kabinetidan olinadi
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# --- Payme To'lov Tizimi (Markaz o'z o'quvchilaridan qabul qilishi uchun) ---
# business.payme.uz merchant kabinetidan olinadi
PAYME_MERCHANT_ID=
PAYME_KEY=

# --- Platforma To'lovlari (O'quv markazlari TalimCRM obunasi uchun to'laydigan hisob) ---
PLATFORM_CLICK_MERCHANT_ID=
PLATFORM_CLICK_SERVICE_ID=
PLATFORM_CLICK_SECRET_KEY=
PLATFORM_PAYME_MERCHANT_ID=
PLATFORM_PAYME_KEY=

# --- SMS Xabarnomalar (Eskiz.uz yoki PlayMobile API) ---
# (Markazlar o'z SMS kalitini Sozlamalar > Xabarnomalar'da ham kiritishi mumkin.)
ESKIZ_API_TOKEN=
ESKIZ_SENDER=4546

PLAYMOBILE_ORIGINATOR=3700
PLAYMOBILE_API_TOKEN=

# --- Elektron Pochta (SMTP — Parolni tiklash, hisob tasdiqlash uchun) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TalimCRM <no-reply@talimcrm.uz>"
# SMTP o'rniga Resend (resend.com) ishlatilsa:
RESEND_API_KEY=
EMAIL_FROM=

# --- Wildcard SSL (*.DOMAIN) uchun Cloudflare DNS API tokeni (Zone:DNS:Edit) ---
# Bo'sh qolsa, init-ssl.sh TXT yozuvni qo'lda qo'shishni so'raydi.
CLOUDFLARE_API_TOKEN=

# --- Sun'iy Intellekt Tahlili (Anthropic Claude API) ---
ANTHROPIC_API_KEY=
# Free alternative when ANTHROPIC_API_KEY is empty (aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Avtomatik eslatmalar (to'lov kuni, dars oldidan) — tekshiruv oralig'i, ms. 0 = o'chiq ---
REMINDER_SCAN_MS=300000

# --- Xatoliklarni Monitoring Qilish (Sentry.io) ---
SENTRY_DSN=

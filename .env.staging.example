# ==============================================================================
# TalimCRM - STAGING environment (template; every value here is a placeholder)
#
#   cp .env.staging.example .env        in the STAGING checkout only
#   ./scripts/staging/preflight-staging.sh
#
# Staging is a second, fully separate copy of the production stack: its own
# checkout folder, containers, database volume, uploads volume, certificates,
# secrets and integrations. It shares NOTHING with production - no database,
# no bot, no merchant account, no secret. See docs/STAGING.md.
# ==============================================================================

# --- What keeps this stack apart from production (do not remove) ---
# Container-name prefix and compose project (volumes + network prefix).
STACK_NAME=talimcrm_staging
COMPOSE_PROJECT_NAME=talimcrm_staging
# Ports published by nginx. 80/443 when staging has its own server (recommended).
# On a server that also runs production, use other ports and put them behind
# the production host's reverse proxy - or better, do not share the server.
HTTP_PORT=80
HTTPS_PORT=443
# Nightly dumps of THIS stack.
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=7

# --- Domain ---
# A domain of its own with a wildcard record: staging.<your domain> and
# *.staging.<your domain> -> the staging server. Centers open at
# <center>.<DOMAIN>. CORS allows only https://<DOMAIN> and one level below it.
DOMAIN=staging.example.uz
FRONTEND_URL=https://staging.example.uz
NEXT_PUBLIC_API_URL=/api

# --- Database (inside this stack's own postgres container and volume) ---
POSTGRES_USER=talimcrm_staging
POSTGRES_PASSWORD=<generate: openssl rand -hex 24  - NOT the production password>
POSTGRES_DB=talimcrm_staging

# --- Redis ---
REDIS_PASSWORD=<generate: openssl rand -hex 24>

# --- Auth ---
# A secret of its own: a production token must not be valid here, or the other way round.
JWT_SECRET=<generate: openssl rand -hex 32  - NOT the production secret>
JWT_EXPIRES_IN=7d

# --- Messaging: OFF until a dedicated test recipient is approved ---
# Automatic reminders (payment, lesson, daily digest). 0 = never send by itself.
REMINDER_SCAN_MS=0
# A SEPARATE bot made for staging (@BotFather -> /newbot). Never the production
# bot's token: setting a webhook on it would take the production bot offline.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=<generate: openssl rand -hex 24>
# SMS: leave empty on staging (real phone numbers would receive real messages).
ESKIZ_API_TOKEN=
ESKIZ_SENDER=4546
PLAYMOBILE_API_TOKEN=
PLAYMOBILE_ORIGINATOR=3700
# E-mail: leave empty (messages are then only logged), or a sandbox inbox.
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TalimCRM Staging <no-reply@staging.example.uz>"

# --- Payments: TEST / SANDBOX merchants only ---
# Values from the providers' test cabinets. Never the live merchant's keys:
# staging must not be able to confirm or cancel a real payment.
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_KEY=
PLATFORM_CLICK_MERCHANT_ID=
PLATFORM_CLICK_SERVICE_ID=
PLATFORM_CLICK_SECRET_KEY=
PLATFORM_PAYME_MERCHANT_ID=
PLATFORM_PAYME_KEY=

# --- AI: optional; a key with its own small quota, or empty ---
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=

# --- Monitoring: a separate project, or empty ---
SENTRY_DSN=

# --- Wildcard certificate (DNS challenge) ---
# A token limited to the staging zone / record, or empty for the manual TXT flow.
CLOUDFLARE_API_TOKEN=

# --- Backups (recovery sets: database + uploaded files) ---
# The nightly run, in UTC (22:00 UTC = 03:00 Tashkent). Sets go to BACKUP_DIR.
BACKUP_AT_UTC=22:00
# Never fewer than this many sets, whatever their age.
BACKUP_MIN_KEEP=3
# 1 = each set is restored into a scratch database before it is accepted.
BACKUP_VERIFY_RESTORE=1

# --- First certificate (scripts/production/init-ssl.sh) ---
LETSENCRYPT_EMAIL=

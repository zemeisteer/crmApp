# TalimCRM backend — local development settings.
# Copy this file to backend/.env (it is git-ignored) and fill in the values:
#   cp backend/.env.example backend/.env        (Windows: copy backend\.env.example backend\.env)

# --- Required ---
# PostgreSQL 16 on this computer: postgresql://USER:PASSWORD@localhost:5432/DBNAME
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talimcrm
# A long random string. Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Centers open at <subdomain>.localhost:3000 on this computer.
ROOT_DOMAIN=localhost

# --- Google Calendar (optional; all of GOOGLE_* or none) ---
# Google Cloud -> Google Auth Platform -> Clients -> Web application.
# The redirect URI added there must be exactly GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/calendar/google/callback
# Encrypts the Google tokens stored in the database. Generate once, then keep it:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CALENDAR_TOKEN_KEY=

# Seals the integration keys the platform admin enters in the panel
# (API & integrations). Without it that page is read-only. Generate once and
# keep it: stored keys cannot be opened with another one.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SETTINGS_KEY=

# --- Other optional integrations: empty means switched off ---
# (each can also be entered in the panel; a value entered there wins)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Tariff lists are translated (RU/EN) by the AI above when it is set, else by
# Google Cloud Translation with this key, else by Google's public endpoint.
GOOGLE_TRANSLATE_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_KEY=

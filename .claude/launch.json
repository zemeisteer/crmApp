{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "backend", "run", "start:dev"],
      "port": 4000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 3000
    },
    {
      "name": "dev-backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "../crmApp-dev/backend", "run", "start:dev"],
      "port": 4100
    },
    {
      "name": "dev-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "../crmApp-dev/frontend", "run", "dev", "--", "-p", "3100"],
      "port": 3100
    }
  ]
}
